# Academy WhatsApp (digits, country code, no +)
NEXT_PUBLIC_ACADEMY_WHATSAPP=201000000001

# Public site URL (for Stripe return links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Hostinger MySQL
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DB_NAME"

# Vercel Blob (required for teacher photo/video/audio upload)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx

# Optional Stripe (live card payments). Without these, demo card pay is used.
# STRIPE_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
