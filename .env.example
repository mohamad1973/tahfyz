# Academy WhatsApp (digits, country code, no +)
NEXT_PUBLIC_ACADEMY_WHATSAPP=201000000001

# Public site URL (for Stripe return links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Hostinger MySQL — use Remote MySQL hostname (NOT localhost) for Vercel/local
# hPanel → Remote MySQL → enable Any Host (%) → copy hostname at top of page
# Encode special chars in password (@ → %40)
DATABASE_URL="mysql://USER:PASSWORD@REMOTE_HOSTNAME:3306/DB_NAME"

# Vercel Blob (required for teacher photo/video/audio upload)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx

# Password reset emails (Resend)
# RESEND_API_KEY=re_xxx
# EMAIL_FROM="Tahfyz <noreply@yourdomain.com>"

# Optional: OpenAI Whisper for mobile voice → text in lesson chat
# OPENAI_API_KEY=sk-...

# Optional Stripe (live card payments). Without these, demo card pay is used.
# STRIPE_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
